# Copie para .env.local e preencha. O .env.local NUNCA vai para o Git (repositório público).
# --- Servidor (rotas em app/api, rodam dentro do próprio Next) ---
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/neondb?sslmode=verify-full
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio
# DevMaster (ERP): só leitura da lista de revendedoras. A chave é a mesma usada pelo admin antigo (apps/backend/.env, DEVMASTER_API_KEY).
DEVMASTER_API_URL=https://app.sorelly.indepcloud.com.br:28576
DEVMASTER_API_KEY=
# DevMaster API 2 (leitura de qualquer tabela do ERP, token JWT; spec em docs/devmaster/openapi.yaml)
DEVMASTER_API_URL_V2=
DEVMASTER_API_KEY_V2=
# DevMaster API 2: a API genérica do ERP (tabelas, fotos, relatórios), documentada em docs/devmaster/openapi.yaml. Token JWT gerado na tela de tokens do DevMaster.
DEVMASTER_API_URL_V2=
DEVMASTER_API_KEY_V2=

# --- Tela (lidas na hora de gerar o sistema: npm run build) ---
# Liga o login e a gravação no servidor. Como o servidor é o próprio Next, o endereço é só /api.
# Vazio = modo antigo: tudo guardado no navegador, sem login.
NEXT_PUBLIC_API_URL=
# Quais módulos sincronizam com o servidor (vazio = os padrões de lib/sync-modulos.js) e quais setores aparecem no menu (vazio = todos).
NEXT_PUBLIC_MODULOS_SERVIDOR=
NEXT_PUBLIC_SETORES_LIGADOS=
NEXT_PUBLIC_ADMIN_ANTIGO_URL=

# --- App real da representante (sorelly-app): integração servidor a servidor (05/11/2026; sorelly-app/docs/app-representante/CONTRATOS.md) ---
# Chave que o backend do app manda em x-ingest-key nas rotas /api/consignado/ingest/* e /api/listagens/app* (IGUAL à CONSIGNADO_INGEST_KEY do backend do app).
CONSIGNADO_INGEST_KEY=
# Backend do app (já termina em /api) e a chave de admin dele (= ADMIN_SECRET do backend do app). Leitura: painel, preferências, pós-vendas.
MOBILE_API_URL=
MOBILE_API_KEY=
# 1 = liga a GRAVAÇÃO no app: envia kits novos, puxa as respostas, avisa "kit pronto" (a cada 60 s) e deixa a Diretoria decidir os pedidos de data.
# Deixe vazio em teste: o MOBILE_API_URL pode apontar para a produção.
APP_REP_SINCRONIZAR=
