{
  "name": "sorelly-admin",
  "private": true,
  "version": "2.0.0",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "gerar-locais": "node scripts/gerar-locais.mjs",
    "predev": "node scripts/gerar-locais.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/gerar-locais.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "verificar": "npm run lint && npm run padrao && npm run build",
    "padrao": "node scripts/conferir-padrao.mjs",
    "padrao:relatorio": "node scripts/conferir-padrao.mjs --relatorio",
    "fotos": "playwright test",
    "fotos:aprovar": "playwright test --update-snapshots",
    "fotos:ver": "playwright show-report",
    "definir-senha": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/definir-senha.mjs",
    "semear-rotina": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/semear-rotina.mjs",
    "migrar-contas": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrar-contas.mjs",
    "criar-admin": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/criar-admin.mjs",
    "conferir": "node scripts/conferir-build.mjs",
    "ver-modulos": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/ver-modulos.mjs",
    "teste-devmaster2": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/teste-devmaster2.mjs",
    "explorar-devmaster2": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/explorar-devmaster2.mjs"
  },
  "dependencies": {
    "@phosphor-icons/web": "2.1.1",
    "jose": "^5.9.6",
    "next": "14.2.35",
    "pg": "^8.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.13",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.13"
  }
}
